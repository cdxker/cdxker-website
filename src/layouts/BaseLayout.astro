---
import "../styles/global.css";
import type { SocialImage } from "../types/social-image";
import FontPicker from "../components/FontPicker.astro";
import { defaultFontId, fontOptions, fontStorageKey, fontStylesheetUrl } from "../data/fonts.js";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  shareImage?: SocialImage;
}

const siteTitle = "Denzell's Website";
const siteDescription =
  "Denzell Ford's personal website. Full stack engineer at Mintlify and founder of Trieve, sharing projects, writing, and interests.";
const { title = siteTitle, description = siteDescription, noindex = false, shareImage } = Astro.props;
const siteUrl = Astro.site ?? new URL("https://cdxker.com/");
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const profileImage = new URL("/profile.png", siteUrl).href;
const socialImage = shareImage ?? {
  src: profileImage,
  width: 460,
  height: 460,
  alt: "Denzell Ford",
  type: "image/png",
};
const socialImageUrl = new URL(socialImage.src, siteUrl).href;
const personId = new URL("/#person", siteUrl).href;
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": new URL("/#website", siteUrl).href,
      url: siteUrl.href,
      name: siteTitle,
      description: siteDescription,
      inLanguage: "en",
      author: { "@id": personId },
    },
    {
      "@type": "Person",
      "@id": personId,
      name: "Denzell Ford",
      alternateName: "cdxker",
      url: siteUrl.href,
      image: profileImage,
      sameAs: ["https://github.com/cdxker", "https://x.com/cdxker"],
    },
  ],
};
---

<!doctype html>
<html lang="en" data-font={defaultFontId}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline define:vars={{ fontOptions, fontStorageKey }}>
      try {
        const saved = localStorage.getItem(fontStorageKey);
        const font = fontOptions.find((option) => option.id === saved);
        if (font) {
          document.documentElement.dataset.font = font.id;
          document.documentElement.style.setProperty("--font-sans", font.stack);
        }
      } catch {
        // The default font works when browser storage is unavailable.
      }
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Denzell Ford" />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large"} />
    <meta name="theme-color" content="#212121" />
    <meta name="color-scheme" content="dark" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" sizes="460x460" href="/profile.png" />
    <link rel="apple-touch-icon" href="/profile.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:secure_url" content={socialImageUrl} />
    <meta property="og:image:type" content={socialImage.type} />
    <meta property="og:image:width" content={socialImage.width} />
    <meta property="og:image:height" content={socialImage.height} />
    <meta property="og:image:alt" content={socialImage.alt} />

    <meta name="twitter:card" content={shareImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:site" content="@cdxker" />
    <meta name="twitter:creator" content="@cdxker" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={socialImage.alt} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href={fontStylesheetUrl}
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")} />
  </head>
  <body class="min-h-screen bg-page font-sans text-white">
    <FontPicker />
    <slot />
  </body>
</html>
