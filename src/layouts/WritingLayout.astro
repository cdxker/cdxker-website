---
import type { CollectionEntry } from "astro:content";
import type { SocialImage } from "../types/social-image";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  entry: CollectionEntry<"essays" | "poems">;
  shareImage?: SocialImage;
}

const { entry, shareImage } = Astro.props;
const date = entry.data.pubDate;
const formattedDate = new Intl.DateTimeFormat("en-US", {
  month: "long",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
}).format(date);
---

<BaseLayout
  title={`${entry.data.title} | Denzell's Website`}
  description={entry.data.description ?? entry.data.title}
  noindex={entry.data.unlisted}
  shareImage={shareImage}
>
  <main class="mx-auto max-w-[44rem] px-6 pt-12 pb-20 wrap-anywhere">
    <a class="text-accent underline-offset-[0.2em] hover:underline" href="/">← Home</a>
    <article>
      <slot name="hero" />
      <header class="mt-12 mb-8">
        <h1 class="mb-3 text-[clamp(2rem,6vw,2.75rem)] leading-[1.2] font-bold tracking-tight">{entry.data.title}</h1>
        <time class="text-[0.875rem] text-muted" datetime={date.toISOString()}>{formattedDate}</time>
      </header>
      <div
        class="text-content leading-[1.8]
          [&_a]:text-accent [&_a]:underline [&_a]:underline-offset-[0.2em]
          [&_:is(p,ul,ol,blockquote,pre)]:my-5
          [&_:is(h2,h3)]:mt-8 [&_:is(h2,h3)]:mb-4
          [&_:is(h2,h3)]:text-[1.4rem] [&_:is(h2,h3)]:leading-[1.4]
          [&_:is(h2,h3)]:font-semibold [&_:is(h2,h3)]:text-white
          [&_:is(ul,ol)]:pl-6 [&_ul]:list-disc [&_ol]:list-decimal
          [&_blockquote]:border-l-2 [&_blockquote]:border-quote-border [&_blockquote]:pl-4
          [&_:is(pre,code,kbd,samp)]:font-serif
          [&_pre]:overflow-x-auto [&_pre]:p-4
          [&_img]:h-auto [&_img]:max-w-full"
      >
        <slot />
      </div>
    </article>
    <slot name="footer" />
  </main>
</BaseLayout>
