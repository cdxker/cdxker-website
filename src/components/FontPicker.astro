---
import { defaultFontId, fontOptions, getFont } from "../data/fonts.js";

const defaultFont = getFont(defaultFontId);
---

<div class="border-b border-divider font-ui">
  <div class="mx-auto flex max-w-5xl flex-col gap-2 px-6 py-3 sm:flex-row sm:items-center sm:gap-6 sm:px-8">
    <div class="grid min-w-0 grid-cols-[auto_minmax(0,1fr)] items-center gap-3 sm:shrink-0">
      <label for="font-picker" class="text-sm text-muted">Typeface</label>
      <select
        id="font-picker"
        aria-describedby="font-description"
        class="min-h-11 min-w-0 rounded-md border border-divider bg-page px-3 text-sm text-content hover:border-muted focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent disabled:opacity-60 sm:w-64"
        disabled
      >
        {fontOptions.map((font) => (
          <option value={font.id} selected={font.id === defaultFontId}>
            {font.name}{font.id === "source-serif-4" ? " · recommended" : ""}
          </option>
        ))}
      </select>
    </div>
    <p id="font-description" aria-live="polite" aria-atomic="true" class="min-h-5 text-sm leading-5 text-muted">
      {defaultFont.description}
    </p>
  </div>
</div>

<script>
  import "../scripts/font-picker.js";
</script>
