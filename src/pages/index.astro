---
import BaseLayout from "../layouts/BaseLayout.astro";
import Experience from "../components/Experience.astro";
---

<BaseLayout>
  <!-- Shell -->
  <div class="mx-auto max-w-5xl p-4 sm:p-6 lg:p-8">
    <div class="p-5 sm:p-8">
      <!-- Header -->
      <header class="flex justify-between">
        <div class="quote-section">
          <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight">Denzell Ford <span
              class="hidden sm:inline">//</span> cdxker</h1>
          <p class="mt-4 text-sm text-neutral-300 top-quote">make software</p>
          <p class="text-sm text-neutral-300 bottom-quote">be happy.</p>
        </div>
        <div class="space-y-1 text-sm">
          <div>cooking <span class="text-yellow-400">@mintlify</span></div>
          <div>ex <span class="text-yellow-400">YC|W24</span></div>
          <div>ex <span class="text-yellow-400">FUTO|F23</span></div>
        </div>

        <img class="w-20 h-20 sm:w-36 sm:h-36"
          src="/profile.png"
          alt="Denzell Ford" width="460" height="460" />
      </header>

      <!-- Intro -->
      <main class="mt-8 text-sm leading-relaxed">
        Hey I'm <span class="text-yellow-400">Denzell!</span>
        <p> Co-founder of <a class="text-yellow-400 underline decoration-yellow-400 hover:decoration-yellow-400"
            href="https://github.com/devflowinc/trieve" target="_blank" rel="noopener">trieve.ai</a>{" "}
          where we created one of the first solutions for search. Bundling analytics, search, recommendations, RAG, and
          Agentic AI.
          Trieve powered 30 thousand+ plus sites and over 150 million plus searches. We made it into the FUTO fellowship program in Fall 2023
          and Y-Combinator for the W24 Batch.
        </p>
        <br />
        <p>
          Currently I'm a full stack engineer at Mintlify, building great things, moving fast (as always), and learning
          new things. I have a passion for code, writing, stationery, keyboards, and music. I've grown tired of journaling privately, I'm starting a new experiment where I publishize it.
          </p>
          <br/>
      </main>

      <!-- Socials -->
      <section id="socials">
        <p class="font-semibold"><span class="text-2xl">/</span>socials</p>
        <ul class="mt-2 list-disc pl-6 text-sm">
          <li><a class="text-yellow-400 hover:underline" href="https://github.com/cdxker" target="_blank"
              rel="noopener">github.com/cdxker</a></li>
          <li><a class="text-yellow-400 hover:underline" href="https://x.com/cdxker" target="_blank"
              rel="noopener">@cdxker</a></li>
          <li><a class="text-yellow-400 hover:underline" href="mailto:me@cdxker.com">me@cdxker.com</a></li>
        </ul>
      </section>


      <!-- Sections -->
      <div class="mt-10 grid grid-cols-1 gap-10">

        <Experience />

        <!-- Projects -->
        <section id="projects">
          <p class="font-semibold"><span class="text-2xl">/</span>projects</p>
          <ul class="mt-2 list-disc pl-6 text-sm">
            <li>Trieve — <span class="font-semibold">All-in-one solution for search, recommendations, and RAG</span>
            </li>
            <li>Uzi — <span class="font-semibold">The full Auto of codegen</span></li>
          </ul>
        </section>

        <section id="friends">
          <p class="font-semibold"><span class="text-2xl">/</span>friends websites</p>
          <ul class="mt-2 list-disc pl-6 text-sm">
            <li><a class="text-yellow-400 hover:underline" href="https://skeptrune.com" target="_blank"
                rel="noopener">skeptrune.com</a></li>
            <li><a class="text-yellow-400 hover:underline" href="https://densumesh.dev/" target="_blank"
                rel="noopener">densumesh.dev</a> </li>
          </ul>
        </section>

        <!-- Inks -->
        <section id="inks">
          <p class="font-semibold"><span class="text-2xl">/</span>inks</p>
          <ul class="mt-2 list-disc pl-6 text-sm leading-7">
            <li>Pilot Iroshizuku <span class="text-yellow-400">ku-jaku</span></li>
            <li>Pilot Iroshizuku <span class="text-yellow-400">kosumosu</span></li>
            <li>Pilot Iroshizuku <span class="text-yellow-400">yama-budo</span></li>
            <li>Dominant Industry <span class="text-yellow-400">Citrus Yellow</span></li>
            <li>Dominant Industry <span class="text-yellow-400">Evening</span></li>
            <li>Diamine <span class="text-yellow-400">Sepia</span></li>
            <li>Diamine <span class="text-yellow-400">Spring Green</span></li>
            <li>Diamine <span class="text-yellow-400">Oxblood</span></li>
            <li>Diamine <span class="text-yellow-400">Emerald</span></li>
            <li>Diamine <span class="text-yellow-400">Marine</span></li>
            <li>Montblanc <span class="text-yellow-400">Royal Blue</span></li>
            <li>Waterman <span class="text-yellow-400">Serenity Blue</span></li>
            <li>Ferris Wheel Press <span class="text-yellow-400">Lady Rose</span></li>
            <li>Jacques Herbin <span class="text-yellow-400">Poussière de Lune</span></li>
            <li>Noodler’s <span class="text-yellow-400">X-Feather Black</span></li>
          </ul>
        </section>

      </div>
    </div>
  </div>

  <script>
    import "../scripts/quotes.js";
  </script>
</BaseLayout>
