---
import { getCollection, render, type CollectionEntry } from "astro:content";
import { getImage } from "astro:assets";
import WritingLayout from "../../layouts/WritingLayout.astro";
import type { SocialImage } from "../../types/social-image";

export async function getStaticPaths() {
  const essays = await getCollection("essays", ({ data }) => !data.draft);
  return essays.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"essays">;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const image = entry.data.image;
const headerImage = image
  ? await getImage({
      src: image.src,
      width: Math.min(image.src.width, 1600),
      format: "jpeg",
    })
  : undefined;
const shareImage: SocialImage | undefined = headerImage && image
  ? {
      src: headerImage.src,
      width: Number(headerImage.attributes.width),
      height: Number(headerImage.attributes.height),
      alt: image.alt,
      type: "image/jpeg",
    }
  : undefined;
---

<WritingLayout entry={entry} shareImage={shareImage}>
  <Fragment slot="hero">
    {shareImage && (
      <img
        class="essay-image"
        src={shareImage.src}
        alt={shareImage.alt}
        width={shareImage.width}
        height={shareImage.height}
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    )}
  </Fragment>
  <Content />
</WritingLayout>

<style>
  .essay-image {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 3rem auto 0;
  }
</style>
