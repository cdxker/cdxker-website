---
import { getCollection, render, type CollectionEntry } from "astro:content";
import WritingLayout from "../../layouts/WritingLayout.astro";

export async function getStaticPaths() {
  const poems = await getCollection("poems", ({ data }) => !data.draft);
  return poems.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"poems">;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const relatedPoems = (await getCollection("poems", ({ id, data }) =>
  id !== entry.id && !data.draft && !data.unlisted
))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime() || a.id.localeCompare(b.id))
  .slice(0, 3);
---

<WritingLayout entry={entry}>
  <Content />
  <section slot="footer" class="mt-12 border-t border-divider pt-6" aria-labelledby="view-also-heading">
    <h2 id="view-also-heading" class="text-[1.125rem] font-semibold">View also</h2>
    {relatedPoems.length > 0 ? (
      <ul class="mt-3 leading-[1.8]">
        {relatedPoems.map((poem) => (
          <li><a class="text-accent underline-offset-[0.2em] hover:underline" href={`/poems/${poem.id}/`}>{poem.data.title}</a></li>
        ))}
      </ul>
    ) : (
      <p class="mt-3 leading-[1.8] text-muted">No other poems yet.</p>
    )}
  </section>
</WritingLayout>
